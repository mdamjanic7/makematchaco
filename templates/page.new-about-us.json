                    "text": "<h4>Our Committment</h4>",
                    "width": "fit-content",
                    "max_width": "narrow",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
